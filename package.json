{
  "name": "d3-org-chart",
  "version": "3.0.0",
  "description": "Highly customizable org chart built with d3.js",
  "main": "dist/d3-org-chart.js",
  "module": "src/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/d3-org-chart.cjs"
    },
    "./modules/*": "./src/*/index.js"
  },
  "files": [
    "src/",
    "dist/",
    "docs/",
    "README.md",
    "LICENSE.md"
  ],
  "keywords": [
    "d3",
    "d3-module",
    "d3-org-chart",
    "org-chart",
    "hierarchy",
    "employee"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bumbeishvili/d3-organization-chart/issues"
  },
  "homepage": "https://github.com/bumbeishvili/d3-organization-chart#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bumbeishvili/d3-organization-chart.git"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "dev": "vite serve sandbox",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "docs:build": "typedoc src/index.js",
    "validate": "npm run lint && npm run test && npm run build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@babel/core": "^7.7.7",
    "@babel/preset-env": "^7.7.7",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.1",
    "@testing-library/dom": "^10.4.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "babel": "^6.23.0",
    "canvas": "^3.1.2",
    "eslint": "^9.32.0",
    "jsdom": "^26.1.0",
    "package-preamble": "0.1",
    "playwright": "^1.54.1",
    "rollup": "0.27",
    "tape": "4",
    "terser": "^5.43.1",
    "uglify-js": "3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "webdriverio": "^9.18.4"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "d3-array": "^3.2.4",
    "d3-flextree": "^2.1.2",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0"
  }
}
